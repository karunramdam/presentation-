/* Global Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
    scroll-behavior: smooth;
}

body {
    background-color: #f8f9fa;
    color: #333;
    line-height: 1.6;
}

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 50px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(5px);
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
}

.logo {
    font-size: 24px;
    font-weight: 700;
    color: #ff3366;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 25px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
}

.nav-links a:hover {
    color: #ffcc00;
}

/* Hero Section with New Background Image */
.hero {
    background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), 
                url('https://images.unsplash.com/photo-1678287424919-ab2432924976?auto=format&fit=crop&w=1350&q=80') no-repeat center center/cover;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    padding: 0 20px;
}

.badge {
    background: #ff3366;
    color: white;
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
    display: inline-block;
}

.hero-content h1 {
    font-size: 48px;
    margin-bottom: 15px;
    text-shadow: 2px 2px 8px rgba(0,0,0,0.6);
}

.hero-content p {
    font-size: 20px;
    margin-bottom: 30px;
    text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
}

.hero-btns {
    display: flex;
    gap: 15px;
    justify-content: center;
}

/* Buttons */
.btn {
    display: inline-block;
    padding: 12px 28px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
}

.btn-primary {
    background: #ff3366;
    color: white;
    box-shadow: 0 4px 15px rgba(255, 51, 102, 0.4);
}

.btn-primary:hover {
    background: #e6004c;
    transform: translateY(-2px);
}

.btn-secondary {
    background: transparent;
    color: white;
    border: 2px solid white;
}

.btn-secondary:hover {
    background: white;
    color: #333;
    transform: translateY(-2px);
}

/* Containers */
.container {
    max-width: 1100px;
    margin: auto;
    padding: 80px 20px;
    text-align: center;
}

/* About Section */
.about-section {
    background: white;
}

.about-section h2, .presentation-section h2, .gallery-section h2, .contact-section h2 {
    font-size: 34px;
    margin-bottom: 15px;
    color: #222;
}

.about-section p, .section-desc {
    font-size: 16px;
    color: #666;
    max-width: 700px;
    margin: auto;
}

/* Mid-Term Presentation Grid */
.presentation-section {
    background: #f1f3f5;
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 40px;
}

.feature-card {
    background: white;
    padding: 35px 25px;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
    text-align: left;
}

.feature-card:hover {
    transform: translateY(-5px);
}

.feature-card i {
    font-size: 36px;
    color: #ff3366;
    margin-bottom: 20px;
}

.feature-card h3 {
    font-size: 20px;
    margin-bottom: 10px;
    color: #333;
}

.feature-card p {
    font-size: 14px;
    color: #666;
}

/* Gallery Section */
.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 40px;
}

.gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 6px 15px rgba(0,0,0,0.1);
}

.gallery-item img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.gallery-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.8));
    overflow: hidden;
    width: 100%;
    height: 100%;
    transition: 0.4s ease;
    display: flex;
    align-items: flex-end;
    padding: 20px;
    opacity: 0;
}

.gallery-overlay span {
    color: white;
    font-weight: 600;
    font-size: 16px;
}

.gallery-item:hover img {
    transform: scale(1.1);
}

.gallery-item:hover .gallery-overlay {
    opacity: 1;
}

/* Contact Section */
.contact-section {
    background: #fff0f3;
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 500px;
    margin: 40px auto 0 auto;
}

.contact-form input, 
.contact-form textarea {
    width: 100%;
    padding: 14px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 15px;
    outline: none;
    transition: border-color 0.3s;
}

.contact-form input:focus, 
.contact-form textarea:focus {
    border-color: #ff3366;
}

.form-feedback {
    font-size: 14px;
    margin-top: 5px;
    font-weight: 500;
}

/* Footer */
footer {
    background: #1a1a1a;
    color: white;
    text-align: center;
    padding: 25px;
    font-size: 14px;
}

footer a {
    color: #ffcc00;
    text-decoration: none;
}
